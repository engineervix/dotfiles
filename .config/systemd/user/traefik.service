[Unit]
Description=Traefik reverse proxy for local dev
After=docker.service

[Service]
ExecStart=/usr/bin/docker compose -f %h/.config/traefik/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f %h/.config/traefik/docker-compose.yml down
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
